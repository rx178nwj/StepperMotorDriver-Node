	(text "COMM STATUS (HIGH = ON)"
		(exclude_from_sim no)
		(at 277.114 257.556 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0e079116-1fb9-493e-9682-c963a930075e")
	)
	(text "LO1/LO2/MO pull-ups: +3V3_D only (external digital 3.3V supply).\nVM and +3V3_D supplied by power circuitry outside this specification."
		(exclude_from_sim no)
		(at 307.848 366.268 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "157c7c15-b09d-4218-b965-97260021d8f9")
	)
	(text "NT1: single PGND-GND copper connection directly beneath IC2 exposed pad.\nEP/corner pads to GND, dense thermal vias; 4 layers / 2oz. Motor outputs: 5A routing."
		(exclude_from_sim no)
		(at 156.464 516.636 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "168ad425-59ca-40cf-b335-8e09127d96fc")
	)
	(text "POWER INPUT 12-24V (J6) / reverse polarity + transient protection"
		(exclude_from_sim no)
		(at 408.94 279.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "19c77b03-0dc5-4bdf-9e44-72b9bc5cfc3d")
	)
	(text "SW4: 1=ADDR0, 2=ADDR1, 3=ADDR2. OFF=0 / ON=1.\nADDR0=PH0, ADDR1=PH1, ADDR2=PC13.\nGPIO inputs, no internal pull; HSE must stay OFF.\nRead at boot: ID = ADDR0 + 2*ADDR1 + 4*ADDR2 (0-7)."
		(exclude_from_sim no)
		(at 245.364 129.032 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "258bfd00-391e-4eaf-af7f-99a229beb5d8")
	)
	(text "AWG22 で 3A 定格のため、3A 運転では余裕がない。\n3A 付近で運転する場合は J4（JST VH B4P-VH、AWG16 で 10A 定格）を使い、\n電線は AWG18 以上にする。J3 と J4 は同じ出力を並列に出すコネクタなので、\n同時に 2 台のモーターはつながない |"
		(exclude_from_sim no)
		(at 250.698 526.034 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "264ec14e-2d78-4cf0-bb41-3fee1baeb0e9")
	)
	(text "USB only: MCU on, motor VM off.\nUSB current before enumeration <=100mA total.\nVM = ADC/4095 * VDDA * 19; wait >=10ms after power changes.\n4.5A is driver absolute peak maximum; initial VREF limit ~1.97A/phase.\nRoute high-current PGND via NT1 only; keep BUCK_SW away from ADC.\nAP2112 dissipation and motor/Q1 cooling require thermal validation."
		(exclude_from_sim no)
		(at 688.086 407.924 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4bf65a14-272c-417a-9929-57a7cc750495")
	)
	(text "MCU STATUS (HIGH = ON)"
		(exclude_from_sim no)
		(at 246.634 257.048 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5834df1f-63f3-471b-86e7-50830c305ace")
	)
	(text "AGC straps: R50=0; R52/R54/R56=100k; R51/R53/R55/R57=DNP.\nCLIM1/BOOST/FLIM pull-ups must use DRV_VCC, never +3V3_D."
		(exclude_from_sim no)
		(at 124.714 402.082 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5860f181-e588-42cd-8447-f7d56f61d120")
	)
	(text "USB FS DEVICE / SELF-POWERED\nUSB_VBUS isolated from board +5V (no backfeed).\nPA9: GPIO VBUS detect; enable USB only with VBUS.\nVDDUSB = +3V3; enable PWR_CR2.USV in firmware.\nInternal D+ pull-up / termination. 90-ohm differential PCB pair."
		(exclude_from_sim no)
		(at 590.804 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5ef820d6-e4ff-4dd1-b53e-6c9b3dfa18fa")
	)
	(text "OSCM: R23=5.1k, C20=270pF; ~67kHz.\nPlace close to pin35. DRV_VCC: internal 5V, setting circuits only."
		(exclude_from_sim no)
		(at 299.974 449.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "782883a0-ca03-49db-b948-5be801dc64fe")
	)
	(text "5V BUCK / 400kHz / 1A"
		(exclude_from_sim no)
		(at 408.94 337.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8005909f-5a06-41ec-8f0d-b51314dc6b96")
	)
	(text "STM32L433 IC4 <-> TB67S249 IC2 - stm32l433_tb67s249_connection.md"
		(exclude_from_sim no)
		(at 125.73 319.532 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "887b055a-302b-476d-9dd6-54adf497d51e")
	)
	(text "EXTERNAL FIRST / USB BACKUP"
		(exclude_from_sim no)
		(at 572.77 345.694 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
