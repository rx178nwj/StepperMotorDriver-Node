	)
	(text "3.3V MCU SUPPLY"
		(exclude_from_sim no)
		(at 650.24 337.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "968d7166-2673-4113-a397-6ca573a883d8")
	)
	(text "VREF: R29=10k series, R30=9.1k to GND, C21=100nF.\n3.3V DAC full scale -> VREF 1.57V -> IOUT 1.97A.\nR30/C21 GND return near pins29/30, away from OUT/VM."
		(exclude_from_sim no)
		(at 319.532 492.252 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a0c81c57-ad71-4ccd-9f02-d989a400ec7e")
	)
	(text "RUN / ACTIVITY (MCU, HIGH = ON)"
		(exclude_from_sim no)
		(at 309.118 257.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a17b11a0-bf4c-4fb8-ae74-683dc5be1cad")
	)
	(text "BOOT0 uses existing boot switch/pulldown (PB8_BOOT net name is legacy).\nUse HSI/MSI internal clock for USB standalone startup."
		(exclude_from_sim no)
		(at 223.52 276.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ac003328-6cc0-438d-b020-1a424fbf68c4")
	)
	(text "A=PA15/TIM2_CH1, B=PA1/TIM2_CH2 (AF1).\n3.3V logic; GPIO/EXTI for home inputs.\nUse MCU pull-ups for dry contact/open-drain sensors."
		(exclude_from_sim no)
		(at 678.18 273.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ad7260c7-3c81-4170-b315-5ad6ddc6255a")
	)
	(text "AS5600 external sensor / 3.3V I2C\nSTM32 I2C1: PB6=SCL, PB7=SDA (AF4)\nJ5: 1=3V3, 2=GND, 3=SCL, 4=SDA\nFit one set of pull-ups on the bus."
		(exclude_from_sim no)
		(at 606.298 243.332 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "af8b1e7f-4af8-4d68-adea-5d058a41137c")
	)
	(text "J8: 1=3V3 VTref, 2=SWDIO, 3=GND\n4=SWCLK, 5=NRST, 6=SWO\nVTref: target voltage sense, no debugger power injection."
		(exclude_from_sim no)
		(at 419.1 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bea1a5ca-8967-4ead-a172-a5f11a911611")
	)
	(text "FAULT (MCU, HIGH = ON)"
		(exclude_from_sim no)
		(at 343.154 258.064 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c1bc90f0-d7fa-434b-8beb-d37fddd74ec4")
	)
	(text "MCU: internal HSI/MSI; USB HSI48 + CRS/SOF.\nPH0/PH1: no external HSE. PC14/PC15 are GPIO, no LSE.\nBOOT0 = PH3 pin44 (PB8_BOOT); PB8 pin45 = DRV_AGC0.\nVDDA/VREF+ share pin9; disable VREFBUF output.\nC38: VBAT 100nF; C39: VDDA 10nF; C40: VDDUSB 1uF.\nPlace bypass capacitors close to their assigned MCU pins.\nNC GPIOs: PA1, PA7, PB2, PA15, PB4, PB5."
		(exclude_from_sim no)
		(at 238.76 271.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "daadd8d4-775c-43f5-8bd2-640226a72eff")
	)
	(text "Firmware: DAC1_OUT1 PA4 buffer enabled; reference VDDA/VREF+ (+3V3_A).\nBuffered DAC may retain ~0.2V: ENABLE Low or disable DAC for zero current.\nStartup: check VM -> set DAC -> set DMODE -> wait >=7.5us -> ENABLE High.\nReset: ENABLE/DMODE/AGC Low; evaluate initially with AGC0=AGC1=Low."
		(exclude_from_sim no)
		(at 156.464 538.396 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "dabc2ebb-771a-41df-970e-3d89339c7938")
	)
	(text "VM sense: 12-24V input, 1/19 divider, powered-off isolation.\nPA0 = ADC1_IN5; VM = ADC/4095 * VDDA * 19.\nWait >=10ms after power switching; ADC sample >=247.5 cycles.\nADDR2 (PC13): R58 pulls low, default address bit 0."
		(exclude_from_sim no)
		(at 431.8 297.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e0e7ac13-2852-41b0-bcdd-7e5e0e59e3b3")
	)
	(text "VM capacitors: C15 bulk 220uF/63V; C16 at VMA; C17 at VMB; C18 10uF/50V.\nKeep VM-PGND loops short; paired pins joined at IC on PCB."
		(exclude_from_sim no)
		(at 113.284 483.108 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e4c4904e-8675-415b-910c-261a0b29f266")
	)
